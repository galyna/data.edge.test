# Server Configuration
PORT=3001
NODE_ENV=development

# API Keys (замените на свои ключи)
# 
# The Odds API - получите бесплатный ключ на https://the-odds-api.com/
# Бесплатный план: 500 запросов в месяц
# Поддерживаемые спорты: футбол (EPL, La Liga, Serie A, Bundesliga, Ligue 1, UCL),
#                        NBA, MLB, NHL, Tennis, MMA
# Поддерживаемые маркеты: h2h (победитель), spreads (форы), totals (тоталы)
THEODDS_API_KEY=your_theodds_key_here

# Sportradar API - получите ключ на https://marketplace.sportradar.com/
# Поддерживает множество видов спорта и лиг
# ⚠️ РАСХОД КВОТЫ: 2 запроса на спорт (Schedule + Markets для каждого события)
# Trial план: 1,000 запросов, 1 QPS, активен до 12/21/2025
SPORTRADAR_API_KEY=your_sportradar_key_here
# Access level: 't' for trial, 'p' for production (default: 't')
SPORTRADAR_ACCESS_LEVEL=t
# Package type: 'us' for US markets, 'row' for Rest of World (default: 'row')
SPORTRADAR_PACKAGE_TYPE=row

# API Settings
API_TIMEOUT=5000
ENABLE_CORS=true
FRONTEND_URL=http://localhost:3000

