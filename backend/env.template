# Server Configuration
PORT=3001
NODE_ENV=development

# API Keys (замените на свои ключи)
# 
# The Odds API - получите бесплатный ключ на https://the-odds-api.com/
# Бесплатный план: 500 запросов в месяц
# Поддерживаемые спорты: футбол (EPL, La Liga, Serie A, Bundesliga, Ligue 1, UCL),
#                        NBA, MLB, NHL, Tennis, MMA
# Поддерживаемые маркеты: h2h (победитель), spreads (форы), totals (тоталы)
THEODDS_API_KEY=your_theodds_key_here

# API Settings
API_TIMEOUT=5000
ENABLE_CORS=true
FRONTEND_URL=http://localhost:3000

